# Образец файла .env для тех, кто склонировал проект.
# 1. Скопируй этот файл в .env (cp .env.example .env)
# 2. Подставь свои реальные значения
# 3. Секреты хранятся только в .env — он в .gitignore, а этот образец можно коммитить.

# Токен бота, который выдаёт @BotFather в Telegram
TELEGRAM_BOT_TOKEN=

# Username бота (без символа @)
TELEGRAM_BOT_USERNAME=